{
  "name": "hailo-node",
  "version": "0.1.0",
  "description": "Node.js client for HailoRT GenAI server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "jordanskole",
  "scripts": {
    "generate-proto": "npx ts-node scripts/generate-proto.ts",
    "build": "npm run generate-proto && tsc",
    "example:chat": "npx ts-node examples/chat.ts",
    "start": "node --env-file=.env --import tsx src/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "hono": "^4.12.25",
    "protobufjs": "^8.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "protobufjs-cli": "^2.5.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
