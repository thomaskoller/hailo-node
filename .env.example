LLM_HOSTNAME="0.0.0.0" # if you are running this on your accelerated raspberry pi
LLM_PORT_NUMBER="12145" # default port for LLM
HEF_LIBRARY_PATH="/usr/local/hailo/resources/models/hailo10h/"
HEF_DEFAULT_MODEL="Qwen2.5-1.5B-Instruct.hef"

# HTTP server settings (Ollama-compatible API)
SERVER_PORT="11434"          # HTTP listen port (Ollama default)
SERVER_HOST="0.0.0.0"       # HTTP bind address (0.0.0.0 = reachable from the whole LAN)
SYSTEM_PROMPT="You are a helpful assistant. Always respond in English."
LANGUAGE="en"
MODEL_DISPLAY_NAME="qwen2.5:1.5b"

# Optional security settings
# API_KEY=""                 # If set, /api/* requires "Authorization: Bearer <API_KEY>"
# MAX_QUEUED_REQUESTS="32"   # Requests beyond this waiting for the device get HTTP 503
